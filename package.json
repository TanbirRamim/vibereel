{
  "name": "vibereel",
  "version": "0.3.0",
  "description": "Turn your latest Claude Code or Codex session into a 30-second shareable film.",
  "homepage": "https://github.com/TanbirRamim/vibereel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanbirRamim/vibereel.git"
  },
  "bugs": {
    "url": "https://github.com/TanbirRamim/vibereel/issues"
  },
  "type": "module",
  "bin": {
    "vibereel": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/player && cp src/player/client.js src/player/player.css dist/player/ && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "demo": "npm run build && node dist/cli.js --file fixtures/demo-dark-mode.jsonl --out assets/demo.html --gif --mp4",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "replay",
    "video",
    "gif",
    "cli",
    "claude",
    "anthropic",
    "openai",
    "session",
    "transcript",
    "screencast",
    "developer-tools",
    "terminal"
  ],
  "license": "MIT",
  "author": "Tanbir Hossain Ramim",
  "optionalDependencies": {
    "puppeteer-core": "^25.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
